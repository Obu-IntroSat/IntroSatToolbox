                    /**
 * Автоматически сгенерированный заголовок протокола.
 * Не редактируйте вручную.
 */
#ifndef PROTOCOL_H
#define PROTOCOL_H

#include <stdint.h>
#include <stdbool.h>

{% for cmd in commands %}
#define {{ cmd.name.upper() }}_CODE {{ cmd.code }}
{% endfor %}

{% for cmd in commands if cmd.type == 'request' %}
/**
 * {{ cmd.description }}
 * Код: {{ cmd.code }}
 */
typedef struct {
    {% for field in cmd.fields %}
    {% if field.type.startswith('uint8[') %}
    uint8_t {{ field.name }}[{{ field.type|replace('uint8[', '')|replace(']', '') }}];
    {% else %}
    {{ field.type }} {{ field.name }};
    {% endif %}
    {% endfor %}
} Request{{ cmd.name }};

{% endfor %}

{% for cmd in commands if cmd.type == 'response' %}
/**
 * {{ cmd.description }}
 * Код: {{ cmd.code }}
 */
typedef struct {
    {% for field in cmd.fields %}
    {% if field.type.startswith('uint8[') %}
    uint8_t {{ field.name }}[{{ field.type|replace('uint8[', '')|replace(']', '') }}];
    {% else %}
    {{ field.type }} {{ field.name }};
    {% endif %}
    {% endfor %}
} Response{{ cmd.name }};

{% endfor %}

// Функции сериализации/десериализации
uint8_t serialize_request(uint8_t cmd_code, const void* req, uint8_t* buf);
uint8_t deserialize_request(uint8_t cmd_code, const uint8_t* buf, void* req);
uint8_t serialize_response(uint8_t cmd_code, const void* resp, uint8_t* buf);
uint8_t deserialize_response(uint8_t cmd_code, const uint8_t* buf, void* resp);

#endif // PROTOCOL_H